# =====================================================================
# Cue & Tap POS — environment variables
# =====================================================================
# Supabase Postgres (transaction pooler, port 6543) for the app runtime.
# Wajib untuk production. Format:
# postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=

# Supabase direct connection (port 5432) — hanya untuk drizzle-kit migrate.
DIRECT_URL=

# Supabase Auth + Realtime (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Opsional - untuk `npm run auth:provision` dan Admin > Staff (JANGAN expose ke client)
SUPABASE_SERVICE_ROLE_KEY=
SEED_STAFF_PASSWORD=

# Di Vercel, demo auth otomatis nonaktif. Set true HANYA untuk staging demo.
DEMO_AUTH=

# URL publik aplikasi (dipakai untuk QR meja & link customer).
# Local: http://localhost:3000 · Vercel: https://nama-app.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Secret untuk menandatangani cookie sesi (mode demo / fallback).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# Opsional: integrasi payment gateway (QRIS).
# Webhook generik: POST /api/webhooks/payment dengan signature HMAC-SHA256
# payload = `${billId}.${amount}.${externalRef}`
PAYMENT_WEBHOOK_SECRET=
# QRIS dinamis: mock | midtrans | xendit (kosong = auto-detect dari key, mock hanya di dev)
PAYMENT_GATEWAY=
MIDTRANS_SERVER_KEY=
MIDTRANS_IS_PRODUCTION=false
XENDIT_SECRET_KEY=
XENDIT_CALLBACK_TOKEN=
# URL callback Midtrans: https://<app>/api/webhooks/payment/gateway
# URL callback Xendit : https://<app>/api/webhooks/payment/gateway

# Opsional: seed data demo saat `npm run db:seed` (default: katalog dasar saja).
SEED_DEMO_DATA=false

# Opsional: override path database demo lokal (PGlite). Default: .data/pglite
DEMO_DB_PATH=
